"""
Estimate the false positive and detection rates of sc2ts recombinant matching
for a range of values of k.

Synthetic single-breakpoint recombinants, and real non-recombinant controls,
are matched against the raw inference ARG for the day before they were
collected. Each mutation multiplier is a separate arm, with the same parents,
breakpoints and controls but different numbers of mutations added to them.

Run from simulations/synthetic_recombinants/, e.g.:
    snakemake --cores 4
"""

configfile: "config.yaml"


K_VALUES = config["k_values"]
MULTIPLIERS = config["mutation_multipliers"]

PREFIX = "synthetic_m{m}"


wildcard_constraints:
    k=r"[0-9]+",
    m=r"[0-9]+",


rule all:
    input:
        "results.csv",


rule make_pool:
    """
    The pool of real samples that parents and controls are drawn from. Slow
    because it reads the sample ids out of the published ARG, so cached.
    """
    input:
        dataset=config["viridian_dataset"],
        reference_arg=config["reference_arg"],
    output:
        "pool.csv",
    shell:
        """
        python simulate.py make-pool \
            {input.dataset} {input.reference_arg} {output} \
            --date {config[sample_date]} --country "{config[country]}"
        """


rule generate:
    input:
        pool="pool.csv",
        dataset=config["viridian_dataset"],
        arg=config["arg"],
    output:
        fasta=f"{PREFIX}.fasta",
        metadata=f"{PREFIX}.metadata.tsv",
        strains=f"{PREFIX}.strains.txt",
        truth=f"{PREFIX}.truth.csv",
    shell:
        """
        python simulate.py generate \
            {input.pool} {input.dataset} {input.arg} \
            --out-prefix synthetic_m{wildcards.m} \
            --date {config[sample_date]} \
            --crosses {config[crosses]} \
            --num-recombinants {config[num_recombinants]} \
            --num-controls {config[num_controls]} \
            --pangonet-data {config[pangonet_data]} \
            --seed {config[seed]} \
            --mutation-multiplier {wildcards.m} \
            --mutation-rate {config[mutation_rate]} \
            --generation-time {config[generation_time]}
        """


rule import_dataset:
    input:
        fasta=f"{PREFIX}.fasta",
        metadata=f"{PREFIX}.metadata.tsv",
    output:
        directory(f"{PREFIX}.vcz"),
    shell:
        """
        sc2ts import-alignments -i {output} {input.fasta}
        sc2ts import-metadata {output} {input.metadata}
        """


rule zip_dataset:
    """
    run-hmm takes a zipped dataset rather than a directory.
    """
    input:
        f"{PREFIX}.vcz",
    output:
        f"{PREFIX}.vcz.zip",
    shell:
        """
        python -c "import sc2ts, sys; sc2ts.Dataset.create_zip(sys.argv[1], sys.argv[2])" \
            {input} {output}
        """


rule run_hmm:
    input:
        dataset=f"{PREFIX}.vcz.zip",
        arg=config["arg"],
        strains=f"{PREFIX}.strains.txt",
    output:
        "hmm_m{m}_k{k}.jsonl",
    threads: config["num_threads"]
    shell:
        """
        sc2ts run-hmm \
            -k {wildcards.k} \
            --num-threads {threads} \
            {input.dataset} {input.arg} $(cat {input.strains}) \
            > {output}
        """


rule parent_strains:
    """
    The parents are the same in every arm, so take them from the first.
    """
    input:
        f"synthetic_m{MULTIPLIERS[0]}.truth.csv",
    output:
        "parents.strains.txt",
    run:
        import pandas as pd

        df = pd.read_csv(input[0], keep_default_na=False)
        df = df[df.type == "recombinant"]
        strains = sorted(set(df.left_parent) | set(df.right_parent))
        with open(output[0], "w") as f:
            for strain in strains:
                print(strain, file=f)


rule match_parents:
    """
    Match the real parents directly, from the Viridian dataset, so unmutated.
    """
    input:
        dataset=config["viridian_dataset"],
        arg=config["arg"],
        strains="parents.strains.txt",
    output:
        "hmm_parents.jsonl",
    threads: config["num_threads"]
    shell:
        """
        sc2ts run-hmm \
            -k {config[parent_match_k]} \
            --num-threads {threads} \
            {input.dataset} {input.arg} $(cat {input.strains}) \
            > {output}
        """


rule summarise:
    input:
        truth=f"{PREFIX}.truth.csv",
        dataset=f"{PREFIX}.vcz",
        arg=config["arg"],
        parents_hmm="hmm_parents.jsonl",
        hmm=expand("hmm_m{{m}}_k{k}.jsonl", k=K_VALUES),
    output:
        "results_m{m}.csv",
    shell:
        """
        python simulate.py summarise \
            {input.truth} {input.dataset} {input.arg} {output} {input.hmm} \
            --parents-hmm {input.parents_hmm} \
            --pangonet-data {config[pangonet_data]}
        """


rule combine:
    input:
        expand("results_m{m}.csv", m=MULTIPLIERS),
    output:
        "results.csv",
    run:
        import pandas as pd

        pd.concat([pd.read_csv(path) for path in input]).to_csv(
            output[0], index=False
        )
