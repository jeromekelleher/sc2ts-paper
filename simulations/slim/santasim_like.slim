// Neutral, panmictic, constant-rates, no-indel, haploid WF simulation,
// inspired by SANTA-SIM (https://academic.oup.com/ve/article/5/1/vez003/5372481).
//
// This follows a simple demographic model, where the population starts with
// one founder, undergoes exponential growth, and then remains constant in size.
//
// Run SLiM, e.g.:
// slim -d N=1000 -d GENS=100 -d GROWTH_GENS=20 -d L=10000 \
//      -d EFF_RECOMB=0.2 -d MU=1e-4 -d S_MAX=100 \
//      -d 'OUT_PREFIX="out"' santasim_like.slim
//
// Parameters:
//   N      Final population size (starts from one founder)
//   GENS   Total number of generations after the founder
//   GROWTH_GENS   Generations of exponential growth to N
//   L      Sequence length
//   EFF_RECOMB   Probability of two-parent reproduction in [0, 1]
//   MU     Mutation rate (per-site per generation) in [0, 1)
//   S_MAX  Maximum number of samples per generation
//   WRITE_ALL     Also write the full pedigree and every sequence (for testing)
//   OUT_PREFIX    Output prefix
//
// Notes:
// At generation g, size = round(N^(g / GROWTH_GENS)) until g = GROWTH_GENS,
// then size stays at N. Runs with GENS < GROWTH_GENS stop during growth.
// Reproduction is clonal whenever the parental population has only one individual.
// Recombination events sample distinct parents uniformly without replacement.
// An individual can be a parent to multiple children.
// For L > 1, every event has exactly one uniformly drawn breakpoint.
//
// Sampling:
// Each generation, individuals are put in a uniformly random order, and the
// first S_MAX (or all of them, if fewer) are candidate samples, with their rank
// in that order. Taking the candidates with rank < S gives a uniform random
// sample of S per generation, nested as S increases. The founder is the only
// individual in generation 0, so is always a candidate. Only candidates are
// remembered in the tree sequence and have their sequences written.
//
// Recombinant ancestry:
// Rather than keep the full pedigree, each individual carries two values,
// inherited at birth along its clonal line:
//   tag    its nearest recombinant ancestor (itself, if it is a recombinant),
//          or -1 if there is none;
//   tagF   its nearest candidate ancestor since that recombinant (or since
//          the founder, if there is none), or -1.
//
// Output:
//   OUT_PREFIX.slim.ts: the tree sequence, remembering the candidates.
//   OUT_PREFIX.slim.sequences.fa: candidate sequences, headed "seq_ID".
//   OUT_PREFIX.slim.samples.tsv: one row per candidate: its generation, pedigree
//     ID, rank, whether it is a recombinant, its recombinant ancestor and its
//     previous candidate (tag and tagF above).
//   OUT_PREFIX.slim.recombinants.tsv: one row per recombinant: its generation,
//     pedigree ID, parents, breakpoint (the position at which copying switches
//     from one parent to the other) and whether its sequence differs from both
//     parents'.
//   With WRITE_ALL, also OUT_PREFIX.slim.pedigree.tsv (every individual) and
//     OUT_PREFIX.slim.all_sequences.fa.

initialize() {
    initializeSLiMModelType("WF");

    // preventIncidentalSelfing=T forces distinct parents.
    initializeSLiMOptions(
        keepPedigrees=T,
        preventIncidentalSelfing=T,
        nucleotideBased=T
    );
    initializeTreeSeq();

    // Set defaults.
    if (!exists("N"))
        defineConstant("N", 100);
    if (!exists("GENS"))
        defineConstant("GENS", 100);
    if (!exists("GROWTH_GENS"))
        defineConstant("GROWTH_GENS", 20);
    if (!exists("L"))
        defineConstant("L", 1000);
    if (!exists("MU"))
        defineConstant("MU", 1e-3);
    if (!exists("EFF_RECOMB"))
        defineConstant("EFF_RECOMB", 0.2);
    if (!exists("S_MAX"))
        defineConstant("S_MAX", 100);
    if (!exists("WRITE_ALL"))
        defineConstant("WRITE_ALL", F);

    defineConstant("OUT_FASTA", OUT_PREFIX + ".slim.sequences.fa");
    defineConstant("OUT_SAMPLES", OUT_PREFIX + ".slim.samples.tsv");
    defineConstant("OUT_RECOMBINANTS", OUT_PREFIX + ".slim.recombinants.tsv");
    defineConstant("OUT_PEDIGREE", OUT_PREFIX + ".slim.pedigree.tsv");
    defineConstant("OUT_ALL_FASTA", OUT_PREFIX + ".slim.all_sequences.fa");
    defineConstant("OUT_TREES", OUT_PREFIX + ".slim.ts");

    if (!isInteger(N) | (N < 1))
        stop("N must be a positive integer.");
    if (!isInteger(GENS) | (GENS < 1))
        stop("GENS must be a positive integer.");
    if (!isInteger(GROWTH_GENS) | (GROWTH_GENS < 1))
        stop("GROWTH_GENS must be a positive integer.");
    if (GENS < GROWTH_GENS)
        stop("GENS must be equal to or greater than GROWTH_GENS.");
    if (!isInteger(L) | (L < 1))
        stop("L must be a positive integer.");
    if ((MU < 0.0) | (MU >= 1.0))
        stop("MU must be in [0, 1).");
    if ((EFF_RECOMB < 0.0) | (EFF_RECOMB > 1.0))
        stop("EFF_RECOMB must be a probability in [0, 1].");
    if (!isInteger(S_MAX) | (S_MAX < 1))
        stop("S_MAX must be a positive integer.");

    defineConstant("END_TICK", GENS + 1);

    // Set mutation type to neutral.
    // Dominance is irrelevant for haploids, so setting coefficient to 1.0 is okay.
    // Fixed ("f") selection coefficient of 0.0.
    initializeMutationTypeNuc("m1", 1.0, "f", 0.0);
    // JC takes mutation rate to each alternative base.
    initializeGenomicElementType("g1", m1, 1.0, mmJukesCantor(MU / 3.0));

    initializeChromosome(1, L, type="H");
    // Entire genome consists of sites subject to neutral mutation.
    initializeGenomicElement(g1, 0, L - 1);

    initializeRecombinationRate(0.0);

    // TODO: Provide a reference genome for more realistic simulations.
    initializeAncestralNucleotides(randomNucleotides(L));
}


1 late() {
    sim.addSubpop("p1", 1);
    p1.setCloningRate(1.0);
    founder = p1.individuals;
    founder.tag = -1;
    founder.tagF = -1.0;

    writeFile(
        OUT_SAMPLES,
        "gen\tid\trank\tis_recombinant\trecombinant_ancestor\tprev_candidate"
    );
    writeFile(
        OUT_RECOMBINANTS,
        "gen\tid\tparent1\tparent2\tbreakpoint\tdetectable"
    );
    if (WRITE_ALL)
        writeFile(OUT_PEDIGREE, "gen\tchild\tparent1\tparent2\tbreakpoint\tis_recombinant");
}


first() {
    // In WF, first() sets the offspring size before reproduction.
    if (community.tick > 1) {
        if (p1.individualCount == 1)
            p1.setCloningRate(1.0);
        else
            p1.setCloningRate(1.0 - EFF_RECOMB);

        generation = community.tick - 1;
        targetSize = N;
        if (generation < GROWTH_GENS)
            targetSize = asInteger(round(exp(log(N) * generation / GROWTH_GENS)));
        p1.setSubpopulationSize(targetSize);
    }
}


recombination() {
    // Exactly one breakpoint: [0, breakpoint) is copied from the first parent's
    // haplosome, [breakpoint, L) from the second's.
    breakpoints = integer(0);
    if (L > 1)
        breakpoints = rdunif(1, 1, sim.chromosome.lastPosition);
    sim.setValue("pending_breakpoints", breakpoints);
    return T;
}


modifyChild() {
    if (isCloning) {
        child.tag = parent1.tag;
        child.tagF = parent1.tagF;
    } else {
        breaks = sim.getValue("pending_breakpoints");
        if (isNULL(breaks))
            stop("Missing recombination record for a two-parent event.");
        sim.setValue("pending_breakpoints", NULL);
        // A child identical to one of its parents carries no trace of the
        // recombination.
        sequence = child.haplosomes[0].nucleotides();
        detectable = (sequence != parent1.haplosomes[0].nucleotides()) &
            (sequence != parent2.haplosomes[0].nucleotides());
        child.setValue("breakpoint", size(breaks) ? breaks[0] else -1);
        child.setValue("detectable", detectable);
        child.tag = child.pedigreeID;
        child.tagF = -1.0;
    }
    return T;
}


late() {
    inds = p1.individuals;
    gen = community.tick - 1;

    recombinants = inds[inds.tag == inds.pedigreeID];
    if (size(recombinants) > 0) {
        parents = recombinants.pedigreeParentIDs;
        rows = string(size(recombinants));
        for (j in seqAlong(recombinants)) {
            ind = recombinants[j];
            rows[j] = paste(c(
                gen, ind.pedigreeID, parents[2 * j], parents[2 * j + 1],
                ind.getValue("breakpoint"), asInteger(ind.getValue("detectable"))
            ), sep="\t");
        }
        writeFile(OUT_RECOMBINANTS, rows, append=T);
    }

    // The first S_MAX individuals in a uniformly random order are candidates.
    order = order(runif(size(inds)));
    num_candidates = min(S_MAX, size(inds));
    candidates = inds[order[seqLen(num_candidates)]];
    writeFile(
        OUT_SAMPLES,
        asString(gen) + "\t" + asString(candidates.pedigreeID) + "\t" +
            asString(seqLen(num_candidates)) + "\t" +
            asString(asInteger(candidates.tag == candidates.pedigreeID)) + "\t" +
            asString(candidates.tag) + "\t" + asString(asInteger(candidates.tagF)),
        append=T
    );
    sequences = sapply(candidates, '">seq_" + applyValue.pedigreeID + "\\n" + applyValue.haplosomes[0].nucleotides();');
    // Overwrite at generation 0, then append.
    writeFile(OUT_FASTA, sequences, append=(gen > 0));
    sim.treeSeqRememberIndividuals(candidates, permanent=T);
    // Children of a candidate have it as their nearest candidate ancestor.
    candidates.tagF = asFloat(candidates.pedigreeID);

    if (WRITE_ALL) {
        parents = inds.pedigreeParentIDs;
        rows = string(size(inds));
        for (j in seqAlong(inds)) {
            ind = inds[j];
            isRecombinant = ind.tag == ind.pedigreeID;
            rows[j] = paste(c(
                gen, ind.pedigreeID, parents[2 * j], parents[2 * j + 1],
                isRecombinant ? ind.getValue("breakpoint") else -1,
                asInteger(isRecombinant)
            ), sep="\t");
        }
        writeFile(OUT_PEDIGREE, rows, append=T);
        sequences = sapply(inds, '">seq_" + applyValue.pedigreeID + "\\n" + applyValue.haplosomes[0].nucleotides();');
        writeFile(OUT_ALL_FASTA, sequences, append=(gen > 0));
    }
}


END_TICK late() {
    sim.treeSeqOutput(OUT_TREES);
    sim.simulationFinished();
}
