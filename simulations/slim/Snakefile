"""
Evaluate sc2ts on SLiM simulations of pathogen-like epidemics.

For each pathogen and replicate, a neutral haploid Wright-Fisher population is
simulated with SLiM, which picks candidate samples from each generation and
tracks their recombinant ancestry. For each of the pathogen's numbers of
samples per day S, S individuals are sampled from each generation, sc2ts is run
on their sequences for each k, and the inferred ARG is scored against the true
ARG (tscompare) and the true recombinants. Each pathogen's results are combined
and copied to summaries/{pathogen}/, which is tracked.

Run from simulations/slim/, e.g.:
    snakemake --cores 8
"""
import json
import re

configfile: "config.yaml"


PATHOGENS = config["pathogens"]
REPLICATES = list(range(config["replicates"]))
K_VALUES = config["k_values"]

DIR = "results/{pathogen}/rep{rep}"
SIM = f"{DIR}/sim"
SAMPLE_DIR = f"{DIR}/s{{s}}"
RUN_DIR = f"{SAMPLE_DIR}/k{{k}}"


wildcard_constraints:
    pathogen="|".join(re.escape(name) for name in PATHOGENS),
    rep=r"[0-9]+",
    s=r"[0-9]+",
    k=r"[0-9]+",


SUMMARIES = ["summary", "events", "placement", "recombinants"]


def seed(wildcards):
    return config["seed"] + int(wildcards.rep)


def samples_per_day(wildcards):
    return PATHOGENS[wildcards.pathogen]["samples_per_day"]


rule all:
    input:
        expand("summaries/{pathogen}/{name}.csv", pathogen=PATHOGENS, name=SUMMARIES),


rule run_slim:
    conda:
        "environment.yml",
    input:
        "santasim_like.slim",
    output:
        trees=f"{SIM}.slim.ts",
        fasta=f"{SIM}.slim.sequences.fa",
        candidates=f"{SIM}.slim.samples.tsv",
        recombinants=f"{SIM}.slim.recombinants.tsv",
    params:
        seed=seed,
        args=lambda wildcards: " ".join(
            f"-d {name}={value}"
            for name, value in PATHOGENS[wildcards.pathogen]["slim"].items()
        ),
        s_max=lambda wildcards: max(samples_per_day(wildcards)),
        prefix=SIM,
    shell:
        """
        slim -s {params.seed} {params.args} -d S_MAX={params.s_max} \
            -d 'OUT_PREFIX="{params.prefix}"' \
            {input}
        """


rule make_reference:
    """
    The founder is the first sequence, and is used as the reference.
    """
    input:
        f"{SIM}.slim.sequences.fa",
    output:
        f"{DIR}/reference.fa",
    shell:
        r"""
        awk '/^>/ {{if (n++) exit}} {{print}}' {input} > {output}
        """


rule sample:
    input:
        trees=f"{SIM}.slim.ts",
        candidates=f"{SIM}.slim.samples.tsv",
    output:
        f"{SAMPLE_DIR}/true.trees",
    shell:
        """
        python pipeline.py sample {input.trees} {input.candidates} {output} \
            --samples-per-day {wildcards.s}
        """


rule export_samples:
    input:
        trees=f"{SAMPLE_DIR}/true.trees",
        fasta=f"{SIM}.slim.sequences.fa",
        candidates=f"{SIM}.slim.samples.tsv",
    output:
        fasta=f"{SAMPLE_DIR}/sequences.fa",
        metadata=f"{SAMPLE_DIR}/metadata.tsv",
    shell:
        """
        python pipeline.py export-samples \
            {input.trees} {input.fasta} {input.candidates} \
            {output.fasta} {output.metadata}
        """


rule make_truth:
    input:
        trees=f"{SAMPLE_DIR}/true.trees",
        candidates=f"{SIM}.slim.samples.tsv",
        recombinants=f"{SIM}.slim.recombinants.tsv",
    output:
        f"{SAMPLE_DIR}/truth.csv",
    shell:
        """
        python pipeline.py make-truth \
            {input.trees} {input.candidates} {input.recombinants} {output}
        """


rule import_dataset:
    input:
        fasta=f"{SAMPLE_DIR}/sequences.fa",
        metadata=f"{SAMPLE_DIR}/metadata.tsv",
        reference=f"{DIR}/reference.fa",
    output:
        directory(f"{SAMPLE_DIR}/dataset.vcz"),
    shell:
        """
        sc2ts import-alignments -i {output} {input.fasta} \
            --reference {input.reference}
        sc2ts import-metadata {output} {input.metadata}
        """


rule zip_dataset:
    input:
        f"{SAMPLE_DIR}/dataset.vcz",
    output:
        f"{SAMPLE_DIR}/dataset.vcz.zip",
    shell:
        """
        python -c "import sc2ts, sys; sc2ts.Dataset.create_zip(sys.argv[1], sys.argv[2])" \
            {input} {output}
        """


rule infer:
    """
    sc2ts writes an ARG for each day; keep the last.
    """
    input:
        dataset=f"{SAMPLE_DIR}/dataset.vcz.zip",
        reference=f"{DIR}/reference.fa",
    output:
        config=f"{RUN_DIR}/sc2ts.toml",
        trees=f"{RUN_DIR}/inferred.ts",
        match_db=f"{RUN_DIR}/sc2ts/matches/{{pathogen}}_rep{{rep}}_s{{s}}_k{{k}}.matches.db",
    params:
        run_id="{pathogen}_rep{rep}_s{s}_k{k}",
        sc2ts_dir=f"{RUN_DIR}/sc2ts",
        extend_parameters=json.dumps(config["sc2ts"]),
    threads: config["num_threads"]
    shell:
        """
        rm -rf {params.sc2ts_dir}
        python pipeline.py write-sc2ts-config {output.config} \
            --dataset {input.dataset} \
            --reference {input.reference} \
            --run-id {params.run_id} \
            --results-dir {params.sc2ts_dir}/results \
            --log-dir {params.sc2ts_dir}/logs \
            --matches-dir {params.sc2ts_dir}/matches \
            --num-mismatches {wildcards.k} \
            --num-threads {threads} \
            --extend-parameters '{params.extend_parameters}'
        sc2ts infer {output.config}
        cp $(ls {params.sc2ts_dir}/results/{params.run_id}/{params.run_id}_*.ts \
            | grep -v _init.ts | sort | tail -n 1) {output.trees}
        """


rule postprocess:
    """
    sc2ts doesn't add a node for a sample identical to one already in the ARG,
    only counting it against that node. Add them from the match DB, as for the
    published ARG, but skip the other tidy-ups (pushing up unary recombinant
    mutations and reversions), so the ARG is otherwise as sc2ts inferred it.
    """
    input:
        trees=f"{RUN_DIR}/inferred.ts",
        match_db=f"{RUN_DIR}/sc2ts/matches/{{pathogen}}_rep{{rep}}_s{{s}}_k{{k}}.matches.db",
    output:
        f"{RUN_DIR}/inferred_pp.ts",
    shell:
        """
        sc2ts postprocess {input.trees} {output} \
            --match-db {input.match_db} --no-mutation-updates --no-progress
        """


rule evaluate:
    """
    Per-sample results stay here; the rest are combined across runs.
    """
    input:
        true=f"{SAMPLE_DIR}/true.trees",
        inferred=f"{RUN_DIR}/inferred_pp.ts",
        truth=f"{SAMPLE_DIR}/truth.csv",
    output:
        evaluation=f"{RUN_DIR}/evaluation.csv",
        events=f"{RUN_DIR}/events.csv",
        placement=f"{RUN_DIR}/placement.csv",
        samples=f"{RUN_DIR}/samples.csv",
    params:
        output_dir=RUN_DIR,
    shell:
        """
        python pipeline.py evaluate \
            {input.true} {input.inferred} {input.truth} {params.output_dir} \
            --pathogen {wildcards.pathogen} --rep {wildcards.rep} \
            --samples-per-day {wildcards.s} --k {wildcards.k}
        """


rule rematch_recombinants:
    """
    Rematch each recombinant against the ARG for the day before it was added,
    with and without recombination, as for the published ARG. This needs
    sc2ts's daily ARGs, which infer leaves in the run's sc2ts/results.
    """
    input:
        f"{RUN_DIR}/inferred.ts",
    output:
        f"{RUN_DIR}/recombinants_rematch.json",
    params:
        pattern=lambda wildcards: (
            "{dir}/sc2ts/results/{run_id}/{run_id}_{{date}}.ts".format(
                dir=RUN_DIR.format(**wildcards),
                run_id="{pathogen}_rep{rep}_s{s}_k{k}".format(**wildcards),
            )
        ),
    shell:
        """
        python pipeline.py rematch-recombinants {input} '{params.pattern}' {output} \
            --k {wildcards.k}
        """


rule recombinant_table:
    input:
        true=f"{SAMPLE_DIR}/true.trees",
        inferred=f"{RUN_DIR}/inferred.ts",
        samples=f"{RUN_DIR}/samples.csv",
        rematches=f"{RUN_DIR}/recombinants_rematch.json",
    output:
        f"{RUN_DIR}/recombinants.csv",
    shell:
        """
        python pipeline.py recombinant-table \
            {input.true} {input.inferred} {input.samples} {input.rematches} {output} \
            --pathogen {wildcards.pathogen} --rep {wildcards.rep} \
            --samples-per-day {wildcards.s} --k {wildcards.k}
        """


rule combine:
    input:
        **{
            name: lambda wildcards, name=name: expand(
                f"{RUN_DIR}/{name}.csv",
                pathogen=wildcards.pathogen,
                rep=REPLICATES,
                s=samples_per_day(wildcards),
                k=K_VALUES,
            )
            for name in ["evaluation", "events", "placement", "recombinants"]
        },
    output:
        evaluation="results/{pathogen}/summary.csv",
        events="results/{pathogen}/events.csv",
        placement="results/{pathogen}/placement.csv",
        recombinants="results/{pathogen}/recombinants.csv",
    run:
        import pandas as pd

        for name in ["evaluation", "events", "placement", "recombinants"]:
            df = pd.concat([pd.read_csv(path) for path in input[name]])
            df.to_csv(output[name], index=False)


rule copy_summary:
    """
    The combined results are small, so are kept in the repository for the
    analysis notebook.
    """
    input:
        "results/{pathogen}/{name}.csv",
    output:
        "summaries/{pathogen}/{name}.csv",
    wildcard_constraints:
        name="|".join(SUMMARIES),
    shell:
        "cp {input} {output}"


rule clean:
    shell:
        "rm -rf results"
