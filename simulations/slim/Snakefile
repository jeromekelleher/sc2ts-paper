"""
Evaluate sc2ts on SLiM simulations of pathogen-like epidemics.

For each pathogen parameter set and replicate, a neutral haploid Wright-Fisher
population is simulated with SLiM, keeping the full pedigree. Individuals are
sampled from all generations with probability P, sc2ts is run on their
sequences for each k, and the inferred ARG is scored against the true ARG
(tscompare) and the true recombinants (the pedigree).

Run from simulations/slim/, e.g.:
    snakemake --cores 8
"""
import json
import re

configfile: "config.yaml"


PATHOGENS = config["pathogens"]
REPLICATES = list(range(config["replicates"]))
P_VALUES = [str(p) for p in config["p_values"]]
K_VALUES = config["k_values"]

DIR = "results/{pathogen}/rep{rep}"
SIM = f"{DIR}/sim"
SAMPLE_DIR = f"{DIR}/p{{p}}"
RUN_DIR = f"{SAMPLE_DIR}/k{{k}}"


wildcard_constraints:
    pathogen="|".join(re.escape(name) for name in PATHOGENS),
    rep=r"[0-9]+",
    p="|".join(re.escape(p) for p in P_VALUES),
    k=r"[0-9]+",


def seed(wildcards):
    return config["seed"] + int(wildcards.rep)


rule all:
    input:
        expand("results/{pathogen}/summary.csv", pathogen=PATHOGENS),


rule run_slim:
    input:
        "santasim_like.slim",
    output:
        pedigree=f"{SIM}.slim.pedigree.tsv",
        fasta=f"{SIM}.slim.sequences.fa",
        trees=f"{SIM}.slim.ts",
    params:
        seed=seed,
        args=lambda wildcards: " ".join(
            f"-d {name}={value}"
            for name, value in PATHOGENS[wildcards.pathogen].items()
        ),
        prefix=SIM,
    shell:
        """
        slim -s {params.seed} {params.args} \
            -d 'OUT_PREFIX="{params.prefix}"' \
            {input}
        """


rule make_reference:
    """
    The founder is the first sequence, and is used as the reference.
    """
    input:
        f"{SIM}.slim.sequences.fa",
    output:
        f"{DIR}/reference.fa",
    shell:
        r"""
        awk '/^>/ {{if (n++) exit}} {{print}}' {input} > {output}
        """


rule sample:
    input:
        f"{SIM}.slim.ts",
    output:
        f"{SAMPLE_DIR}/true.trees",
    params:
        seed=seed,
    shell:
        """
        python pipeline.py sample {input} {output} \
            --probability {wildcards.p} --seed {params.seed}
        """


rule export_samples:
    input:
        trees=f"{SAMPLE_DIR}/true.trees",
        fasta=f"{SIM}.slim.sequences.fa",
        pedigree=f"{SIM}.slim.pedigree.tsv",
    output:
        fasta=f"{SAMPLE_DIR}/sequences.fa",
        metadata=f"{SAMPLE_DIR}/metadata.tsv",
    shell:
        """
        python pipeline.py export-samples \
            {input.trees} {input.fasta} {input.pedigree} \
            {output.fasta} {output.metadata}
        """


rule make_truth:
    input:
        trees=f"{SAMPLE_DIR}/true.trees",
        fasta=f"{SIM}.slim.sequences.fa",
        pedigree=f"{SIM}.slim.pedigree.tsv",
    output:
        f"{SAMPLE_DIR}/truth.csv",
    shell:
        """
        python pipeline.py make-truth \
            {input.trees} {input.fasta} {input.pedigree} {output}
        """


rule import_dataset:
    input:
        fasta=f"{SAMPLE_DIR}/sequences.fa",
        metadata=f"{SAMPLE_DIR}/metadata.tsv",
        reference=f"{DIR}/reference.fa",
    output:
        directory(f"{SAMPLE_DIR}/dataset.vcz"),
    shell:
        """
        sc2ts import-alignments -i {output} {input.fasta} \
            --reference {input.reference}
        sc2ts import-metadata {output} {input.metadata}
        """


rule zip_dataset:
    input:
        f"{SAMPLE_DIR}/dataset.vcz",
    output:
        f"{SAMPLE_DIR}/dataset.vcz.zip",
    shell:
        """
        python -c "import sc2ts, sys; sc2ts.Dataset.create_zip(sys.argv[1], sys.argv[2])" \
            {input} {output}
        """


rule infer:
    """
    sc2ts writes an ARG for each day; keep the last.
    """
    input:
        dataset=f"{SAMPLE_DIR}/dataset.vcz.zip",
        reference=f"{DIR}/reference.fa",
    output:
        config=f"{RUN_DIR}/sc2ts.toml",
        trees=f"{RUN_DIR}/inferred.ts",
    params:
        run_id="{pathogen}_rep{rep}_p{p}_k{k}",
        sc2ts_dir=f"{RUN_DIR}/sc2ts",
        extend_parameters=json.dumps(config["sc2ts"]),
    threads: config["num_threads"]
    shell:
        """
        rm -rf {params.sc2ts_dir}
        python pipeline.py write-sc2ts-config {output.config} \
            --dataset {input.dataset} \
            --reference {input.reference} \
            --run-id {params.run_id} \
            --results-dir {params.sc2ts_dir}/results \
            --log-dir {params.sc2ts_dir}/logs \
            --matches-dir {params.sc2ts_dir}/matches \
            --num-mismatches {wildcards.k} \
            --num-threads {threads} \
            --extend-parameters '{params.extend_parameters}'
        sc2ts infer {output.config}
        cp $(ls {params.sc2ts_dir}/results/{params.run_id}/{params.run_id}_*.ts \
            | grep -v _init.ts | sort | tail -n 1) {output.trees}
        """


rule evaluate:
    """
    Per-sample results stay here; the rest are combined across runs.
    """
    input:
        true=f"{SAMPLE_DIR}/true.trees",
        inferred=f"{RUN_DIR}/inferred.ts",
        truth=f"{SAMPLE_DIR}/truth.csv",
    output:
        evaluation=f"{RUN_DIR}/evaluation.csv",
        events=f"{RUN_DIR}/events.csv",
        placement=f"{RUN_DIR}/placement.csv",
        samples=f"{RUN_DIR}/samples.csv",
    params:
        output_dir=RUN_DIR,
    shell:
        """
        python pipeline.py evaluate \
            {input.true} {input.inferred} {input.truth} {params.output_dir} \
            --pathogen {wildcards.pathogen} --rep {wildcards.rep} \
            --p {wildcards.p} --k {wildcards.k}
        """


rule combine:
    input:
        **{
            name: expand(
                f"{RUN_DIR}/{name}.csv",
                rep=REPLICATES,
                p=P_VALUES,
                k=K_VALUES,
                allow_missing=True,
            )
            for name in ["evaluation", "events", "placement"]
        },
    output:
        evaluation="results/{pathogen}/summary.csv",
        events="results/{pathogen}/events.csv",
        placement="results/{pathogen}/placement.csv",
    run:
        import pandas as pd

        for name in ["evaluation", "events", "placement"]:
            df = pd.concat([pd.read_csv(path) for path in input[name]])
            df.to_csv(output[name], index=False)


rule clean:
    shell:
        "rm -rf results"
