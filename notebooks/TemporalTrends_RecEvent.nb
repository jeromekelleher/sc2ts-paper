Cell["\<\
Cases (blue) and recombination events (black), both scaled to their maxima:\
\>", "Text",
 CellChangeTimes->{{3.965167755529792*^9, 
  3.9651677774325666`*^9}},ExpressionUUID->"79002744-6034-45bf-9e86-\
c7d0a812fc60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"recevents", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"recevents", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "/", 
         RowBox[{"Max", "[", 
          RowBox[{"recevents", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}]}], "}"}], "]"}], 
     ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"PlotStyle", "->", "Black"}], ",", 
     RowBox[{"Ticks", "->", 
      RowBox[{"{", 
       RowBox[{"xaxis", ",", "Automatic"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"dates", ",", 
        RowBox[{"cases", "/", 
         RowBox[{"Max", "[", "cases", "]"}]}]}], "}"}], "]"}], ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"PlotStyle", "->", "Blue"}], ",", 
     RowBox[{"Ticks", "->", 
      RowBox[{"{", 
       RowBox[{"xaxis", ",", "Automatic"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
