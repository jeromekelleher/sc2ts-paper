Cell["\<\
Use this code to change the colors:
https://mathematica.stackexchange.com/questions/18495/how-to-convert-a-hex-\
color-string-to-rgbcolor\
\>", "Text",
 CellChangeTimes->{{3.955284756256199*^9, 
  3.955284768893717*^9}},ExpressionUUID->"346f4dbf-b377-4a14-b895-\
aeda62ea6295"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hexToRGB", "=", 
  RowBox[{
   RowBox[{"RGBColor", "@@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IntegerDigits", "[", 
       RowBox[{
        RowBox[{"ToExpression", "@", 
         RowBox[{"StringReplace", "[", 
          RowBox[{"#", ",", 
           RowBox[{"\"\<#\>\"", "->", "\"\<16^^\>\""}]}], "]"}]}], ",", "256",
         ",", "3"}], "]"}], "/", "255."}], ")"}]}], "&"}]}]], "Input",
 CellChangeTimes->{{3.955284739867793*^9, 3.955284739869171*^9}, 
   3.955286177825049*^9},
 CellLabel->
  "In[131]:=",ExpressionUUID->"5dfb00bd-b945-441a-b287-5d4256b77be4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RGBColor", "@@", 
   FractionBox[
    RowBox[{"IntegerDigits", "[", 
     RowBox[{
      RowBox[{"ToExpression", "[", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"#1", ",", 
         RowBox[{"\<\"#\"\>", "\[Rule]", "\<\"16^^\"\>"}]}], "]"}], "]"}], ",",
       "256", ",", "3"}], "]"}], "255.`"]}], "&"}]], "Output",
 CellChangeTimes->{
