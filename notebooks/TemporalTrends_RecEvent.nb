Cell["\<\
Use this code to change the colors:
https://mathematica.stackexchange.com/questions/18495/how-to-convert-a-hex-\
color-string-to-rgbcolor\
\>", "Text",
 CellChangeTimes->{{3.955284756256199*^9, 
  3.955284768893717*^9}},ExpressionUUID->"99755dff-b358-4f27-bc34-\
8e6f6d99ff21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hexToRGB", "=", 
  RowBox[{
   RowBox[{"RGBColor", "@@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IntegerDigits", "[", 
       RowBox[{
        RowBox[{"ToExpression", "@", 
         RowBox[{"StringReplace", "[", 
          RowBox[{"#", ",", 
           RowBox[{"\"\<#\>\"", "->", "\"\<16^^\>\""}]}], "]"}]}], ",", "256",
         ",", "3"}], "]"}], "/", "255."}], ")"}]}], "&"}]}]], "Input",
 CellChangeTimes->{{3.955284739867793*^9, 3.955284739869171*^9}, 
   3.955286177825049*^9},
 CellLabel->"In[43]:=",ExpressionUUID->"3471ab7f-ff90-4a7a-8cfb-49a4089cee57"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RGBColor", "@@", 
   FractionBox[
    RowBox[{"IntegerDigits", "[", 
     RowBox[{
      RowBox[{"ToExpression", "[", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"#1", ",", 
         RowBox[{"\<\"#\"\>", "\[Rule]", "\<\"16^^\"\>"}]}], "]"}], "]"}], ",",
       "256", ",", "3"}], "]"}], "255.`"]}], "&"}]], "Output",
 CellChangeTimes->{
  3.955284742469927*^9, {3.955286175044395*^9, 3.955286178428047*^9}, 
