Cell["Adding zeros into the table for plotting:", "Text",
 CellChangeTimes->{{3.9537209408225203`*^9, 
  3.953720947118576*^9}},ExpressionUUID->"0293ccd2-8c55-4abe-80d7-\
7578e30bb793"],

Cell[BoxData[
 RowBox[{
  RowBox[{"recevents", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"temp", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Select", "[", 
         RowBox[{"recevents", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "==", "ii"}], "&"}]}], "]"}], 
        "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "temp", "]"}], ">", "0"}], ",", "temp", ",", 
        RowBox[{"{", 
         RowBox[{"ii", ",", "0"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", 
       RowBox[{"Max", "[", "dates", "]"}], ",", "7"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.953720909616743*^9, 3.953720936213952*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"d1fd0825-e2de-468a-9ce9-c6926efb1e75"],

