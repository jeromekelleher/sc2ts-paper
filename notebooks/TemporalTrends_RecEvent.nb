Cell["\<\
Gathering all variants by week (note that we must multiply by the number \
observed on a day, \[OpenCurlyDoubleQuote]exact_matches\
\[CloseCurlyDoubleQuote]):\
\>", "Text",
 CellChangeTimes->{{3.9552804333302603`*^9, 3.955280446584354*^9}, {
  3.9555323006889877`*^9, 
  3.955532312990068*^9}},ExpressionUUID->"ff4f341d-703a-486b-b4b1-\
de743e25eb20"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"temp", ",", "varnum"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"ii", "=", "1"}], ",", 
   RowBox[{"ii", "\[LessEqual]", 
    RowBox[{"Length", "[", "types", "]"}]}], ",", 
   RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"temp", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"var", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"varheader", ",", "\"\<scorpio\>\""}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "==", 
         RowBox[{"types", "[", 
          RowBox[{"[", "ii", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"jj", "=", "1"}], ";", 
       RowBox[{"temp2", "=", 
        RowBox[{"{", "}"}]}]}], ",", 
      RowBox[{"jj", "\[LessEqual]", 
       RowBox[{"Length", "[", "temp", "]"}]}], ",", 
      RowBox[{"jj", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"day", " ", "=", " ", 
        RowBox[{"temp", "[", 
         RowBox[{"[", 
          RowBox[{"jj", ",", 
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"varheader", ",", "\"\<date\>\""}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"week", "=", 
        RowBox[{"1", "+", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"curdate", "[", "day", "]"}], ",", "7"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"temp2", "=", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"temp2", ",", 
          RowBox[{"{", 
           RowBox[{"week", ",", " ", 
            RowBox[{"temp", "[", 
             RowBox[{"[", 
              RowBox[{"jj", ",", 
               RowBox[{
                RowBox[{"Position", "[", 
                 RowBox[{"varheader", ",", "\"\<exact_matches\>\""}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}]}], 
           "}"}]}], "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"temp4", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"temp3", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"temp2", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "i"}], "&"}]}], "]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "temp3", "]"}], ">", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Total", "[", 
             RowBox[{"temp3", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Max", "[", "dates", "]"}], ",", "7"}], "}"}]}], "]"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", "temp4", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "!=", "vardates"}], ",", 
      RowBox[{"Print", "[", "\"\<error\>\"", "]"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"varnum", "[", "ii", "]"}], "=", 
     RowBox[{
      RowBox[{"Transpose", "[", "temp4", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9548620919399433`*^9, 3.954862096022998*^9}, {
