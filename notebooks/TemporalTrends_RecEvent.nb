Cell["\<\
Testing p-value by randomization (all 10,000 had slopes of lower magnitude):\
\>", "Text",
 CellChangeTimes->{{3.956745491433476*^9, 
  3.956745509171114*^9}},ExpressionUUID->"546cebfd-da06-4d86-bcda-\
4fef6628e4b1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "9324", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"jj", "=", "1"}], ";", 
    RowBox[{"sig", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}]}], ",", 
   RowBox[{"jj", "\[LessEqual]", "10000"}], ",", 
   RowBox[{"jj", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tempcases", "=", 
     RowBox[{"RandomSample", "[", "cases", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tempfit", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tempcases", ",", 
          RowBox[{"recevents", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", "x", "}"}], ",", "x"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"tempfit", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], ">", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"lm", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"sig", "=", 
       RowBox[{"sig", "+", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}]}], ",", 
      RowBox[{"sig", "=", 
       RowBox[{"sig", "+", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}]}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"sig", "/", "10000"}]}], "Input",
 CellChangeTimes->{{3.956744760344089*^9, 3.956744780438855*^9}, {
   3.956745315376952*^9, 3.95674547771554*^9}, {3.956745552005053*^9, 
