Cell["Removing header and dates before and after the time period:", "Text",
 CellChangeTimes->{{3.954862755798148*^9, 
  3.954862764594697*^9}},ExpressionUUID->"839faa22-0f00-408c-9e1e-\
92f63d8ec239"],

Cell[BoxData[
 RowBox[{
  RowBox[{"datepos", "=", 
   RowBox[{
    RowBox[{"Position", "[", 
     RowBox[{"varheader", ",", "\"\<date\>\""}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.965167918965994*^9, 3.965167927030723*^9}},
 CellLabel->
  "In[125]:=",ExpressionUUID->"160559fe-2a8a-45ce-9098-06380e3bb458"],

Cell[BoxData[
 RowBox[{
  RowBox[{"var", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"var", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", "All"}], "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"curdate", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "datepos", "]"}], "]"}], "]"}], "\[GreaterEqual]", 
         RowBox[{"curdate", "[", "startafter", "]"}]}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"curdate", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "datepos", "]"}], "]"}], "]"}], "\[LessEqual]", 
         RowBox[{"curdate", "[", "endatdate", "]"}]}], ")"}]}], "&"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.954862766856182*^9, 3.9548628035850277`*^9}, {
  3.955280099918037*^9, 3.9552801037427*^9}, {3.955280228092317*^9, 
