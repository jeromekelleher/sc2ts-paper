Cell["\<\
Testing p-value by randomization (all 10,000 had slopes of lower magnitude):\
\>", "Text",
 CellChangeTimes->{{3.956745491433476*^9, 
  3.956745509171114*^9}},ExpressionUUID->"35a8b974-96a3-4b3e-810f-\
351a64a6bf5e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1239", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"jj", "=", "1"}], ";", 
    RowBox[{"sig", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}]}], ",", 
   RowBox[{"jj", "\[LessEqual]", "10000"}], ",", 
   RowBox[{"jj", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tempcases", "=", 
     RowBox[{"RandomSample", "[", "tabHET", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tempfit", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tempcases", ",", 
          RowBox[{"recevents", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", "x", "}"}], ",", "x"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"tempfit", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], ">", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"lm", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"sig", "=", 
       RowBox[{"sig", "+", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}]}], ",", 
      RowBox[{"sig", "=", 
       RowBox[{"sig", "+", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}]}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"sig", "/", "10000"}]}], "Input",
