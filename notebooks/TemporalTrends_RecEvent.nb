Cell[TextData[{
 "We ask which single predictor best predicts the number of recombinant \
events (cases, het, cases*het, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["cases", "2"], TraditionalForm]],ExpressionUUID->
  "868cfc56-c910-4a24-ac47-f1c0d16e951e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["cases", "2"], TraditionalForm]],ExpressionUUID->
  "b0f82835-de63-4ca6-a367-5b902c4c1f91"],
 "*het). The interest in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["cases", "2"], TraditionalForm]],ExpressionUUID->
  "bea1f668-5950-41cb-bd77-0e49d88ae043"],
 " stems from the possibility that double infections may rise with the square \
of the contact rates with other infected individuals. We do not assume an \
intercept at 0 because the case numbers are not well estimated, so we do not \
force the intercept."
}], "Text",
 CellChangeTimes->{{3.9566535172453012`*^9, 3.956653532865006*^9}, {
  3.956662214284451*^9, 3.956662214457554*^9}, {3.956665636548894*^9, 
  3.956665652716736*^9}, {3.965169307706542*^9, 
  3.965169418022421*^9}},ExpressionUUID->"a0b97d11-6438-4fd5-a342-\
e39ba551c070"],

Cell[TextData[{
 "The expected heterozygosity on each day (",
 Cell[BoxData[
  RowBox[{"1", "-", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "types"], 
    RowBox[{
     SubscriptBox["p", "i"], "\[LeftDoubleBracket]", "j", 
     "\[RightDoubleBracket]"}]}]}]],
  CellChangeTimes->{{3.95613269361449*^9, 3.956132707735806*^9}},
  ExpressionUUID->"756048dd-5d70-4534-92ac-a9b571b0e771"],
 "):"
}], "Text",
 CellChangeTimes->{{3.956132662868655*^9, 3.956132671235618*^9}, {
  3.9561327130932817`*^9, 3.956132732190742*^9}, {3.956141473621964*^9, 
  3.956141475407105*^9}, {3.9561415642528667`*^9, 3.956141565979745*^9}, {
  3.965169428041277*^9, 
  3.9651694556176033`*^9}},ExpressionUUID->"21585d8c-d7bd-4145-84c6-\
af84d00400e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tabHET", "=", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"1", "-", 
      RowBox[{"Sum", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            RowBox[{"varnum", "[", "i", "]"}], "[", 
            RowBox[{"[", "j", "]"}], "]"}], 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"varnum", "[", "ii", "]"}], "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"ii", ",", "1", ",", 
               RowBox[{"Length", "[", "types", "]"}]}], "}"}]}], "]"}]], 
          ")"}], "2"], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "types", "]"}]}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "vardates", "]"}]}], "}"}]}], "]"}], "//", 
   "N"}]}]], "Input",
 CellChangeTimes->{{3.956132445240162*^9, 3.956132498157672*^9}, {
   3.9561325419980803`*^9, 3.9561325477215767`*^9}, {3.956132595168729*^9, 
   3.9561326020763693`*^9}, 3.9561326581375237`*^9},
 CellLabel->
  "In[148]:=",ExpressionUUID->"16767cf8-b6a1-4cea-9f49-62b88d85009d"],

