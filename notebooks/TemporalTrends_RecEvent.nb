Cell[BoxData[
 RowBox[{
  RowBox[{"var", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"var", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", "All"}], "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"curdate", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "datepos", "]"}], "]"}], "]"}], "\[GreaterEqual]", 
         RowBox[{"curdate", "[", "startafter", "]"}]}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"curdate", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "datepos", "]"}], "]"}], "]"}], "\[LessEqual]", 
