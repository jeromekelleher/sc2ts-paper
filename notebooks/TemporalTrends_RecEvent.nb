Cell[BoxData[
 RowBox[{
  RowBox[{"recevents", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"temp", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Select", "[", 
         RowBox[{"recevents", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "==", "ii"}], "&"}]}], "]"}], 
        "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "temp", "]"}], ">", "0"}], ",", "temp", ",", 
        RowBox[{"{", 
         RowBox[{"ii", ",", "0"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", 
       RowBox[{"Max", "[", "dates", "]"}], ",", "7"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
