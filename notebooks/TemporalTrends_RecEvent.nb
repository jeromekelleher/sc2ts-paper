Cell["\<\
Cumulative plots, first based on the number of lineages in the ARG each week \
(x1000) relative to case numbers in the Veridian dataset:\
\>", "Text",
 CellChangeTimes->{{3.955281125146056*^9, 3.955281127554296*^9}, {
  3.956665128994308*^9, 3.956665139943646*^9}, {3.965168101949746*^9, 
  3.9651681268914433`*^9}},ExpressionUUID->"0a255d43-f965-4fbb-8a73-\
2adeeb8ed8ff"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "cumvarnum", "]"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"ii", "=", "1"}], ",", 
   RowBox[{"ii", "\[LessEqual]", 
    RowBox[{"Length", "[", "types", "]"}]}], ",", 
   RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cumvarnum", "[", "ii", "]"}], "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"varnum", "[", "j", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "ii"}], "}"}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.954864931725718*^9, 3.954864973765562*^9}, {
  3.9552785043000803`*^9, 3.955278552041066*^9}, {3.955278582917342*^9, 
  3.955278599729965*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"76cce616-5b17-44d6-ad20-1b59e033aa4f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"vardates", ",", 
          RowBox[{"cumvarnum", "[", "i", "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "types", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"Joined", "\[Rule]", "True"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.002", "]"}], ",", "Gray"}], "}"}], 
       "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Filling", "\[Rule]", "filltab"}], ",", 
     RowBox[{"AspectRatio", "->", 
      RowBox[{"1", "/", "2"}]}], ",", 
     RowBox[{"Ticks", "->", 
      RowBox[{"{", 
       RowBox[{"xaxis", ",", "Automatic"}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "600"}]}], "]"}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"recevents", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"5000", "*", 
         RowBox[{"recevents", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "}"}], "]"}], ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thickness", "[", "0.002", "]"}], ",", "Black"}], "}"}]}]}], 
    "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"1", "/", "2"}]}], ",", 
   RowBox[{"Ticks", "->", 
    RowBox[{"{", 
     RowBox[{"xaxis", ",", "Automatic"}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "600"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
