Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "2323", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"jj", "=", "1"}], ";", 
    RowBox[{"sig", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}]}], ",", 
   RowBox[{"jj", "\[LessEqual]", "10000"}], ",", 
   RowBox[{"jj", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tempcases", "=", 
     RowBox[{"RandomSample", "[", 
      RowBox[{"cases", "*", "tabHET"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tempfit", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tempcases", ",", 
          RowBox[{"recevents", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", "x", "}"}], ",", "x"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"tempfit", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], ">", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"lm", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"sig", "=", 
       RowBox[{"sig", "+", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}]}], ",", 
      RowBox[{"sig", "=", 
       RowBox[{"sig", "+", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}]}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"sig", "/", "10000"}]}], "Input",
